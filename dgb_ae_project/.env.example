# === Sécurité Django ===
# OBLIGATOIRE : sans cette clé, une clé temporaire est régénérée à chaque
# démarrage, ce qui invalide les sessions ("Session data corrupted") et vous
# déconnecte à chaque redémarrage du serveur.
# Générer une clé :  python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-moi-avec-une-cle-secrete-forte

# En DÉVELOPPEMENT local (runserver), mettre True : les fichiers statiques sont
# alors servis directement, sans avoir à lancer `collectstatic`.
# En PRODUCTION, laisser False et lancer `python manage.py collectstatic`.
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,votre-domaine.gouv.cm

# === Base de données PostgreSQL ===
DB_ENGINE=django.db.backends.postgresql
DB_NAME=dgb_ae_db
DB_USER=dgb_ae_user
DB_PASSWORD=change-moi
DB_HOST=localhost
DB_PORT=5432

# Repli local (développement uniquement, sans PostgreSQL) :
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3

# === Authentification Google (django-allauth) ===
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# === Email (réinitialisation de mot de passe) ===
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=DGB - MINFI <no-reply@minfi.gov.cm>

# === xAI / Grok (assistant IA d'interprétation des prévisions) ===
XAI_API_KEY=xai-votre-cle-ici
XAI_API_URL=https://api.x.ai/v1/chat/completions
XAI_MODEL=grok-4-latest

# === Divers ===
CSRF_TRUSTED_ORIGINS=https://votre-domaine.gouv.cm
